import shutil
import os
import subprocess
import tarfile
import hashlib

from isolation import run_in_sandbox


# ------------------ COPY ------------------
def handle_copy(src, dest, context, temp_fs):
    src_path = os.path.join(context, src)
    dest_path = os.path.join(temp_fs, dest.lstrip("/"))

    if not os.path.exists(src_path):
        raise Exception(f"Source path does not exist: {src}")

    os.makedirs(dest_path, exist_ok=True)

    if os.path.isfile(src_path):
        shutil.copy2(src_path, os.path.join(dest_path, os.path.basename(src_path)))
        return

    for item in os.listdir(src_path):
        if item == ".git" or item.startswith("."):
            continue
        s = os.path.join(src_path, item)
        d = os.path.join(dest_path, item)
        if os.path.isdir(s):
            shutil.copytree(s, d, dirs_exist_ok=True)
        else:
            shutil.copy2(s, d)


# ------------------ SNAPSHOT ------------------
def snapshot_fs(temp_fs):
    """Returns a dict of {relative_path: mtime} for current temp_fs state."""
    state = {}
    for root, dirs, files in os.walk(temp_fs):
        for f in files:
            abs_path = os.path.join(root, f)
            rel_path = os.path.relpath(abs_path, temp_fs)
            state[rel_path] = os.path.getmtime(abs_path)
    return state


# ------------------ RUN (with isolation, fallback) ------------------
def handle_run(command, temp_fs):
    """
    Runs command inside an isolated ephemeral root created from temp_fs using sandboxing.
    Falls back to running in the temp_fs cwd when sandbox tools aren't available (macOS dev fallback).
    """
    try:
        rc = run_in_sandbox(temp_fs, command)
        if rc != 0:
            raise subprocess.CalledProcessError(rc, command)
        return
    except RuntimeError as e:
        # Sandbox not available on this host — fallback to running in the temp_fs (dev only)
        print("[SANDBOX FALLBACK]", e)
    except FileNotFoundError:
        # Command not found in sandbox; fall back
        print("[SANDBOX FALLBACK] command/tool not found")

    # macOS / fallback: run command in temp_fs as cwd
    env = os.environ.copy()
    env["HOME"] = temp_fs

    try:
        subprocess.run(["sh", "-c", command], cwd=temp_fs, check=True, env=env)
    except subprocess.CalledProcessError as e:
        raise


# ------------------ CREATE LAYER (delta, reproducible) ------------------
def create_layer(temp_fs, layers_dir, before_snapshot=None):
    """
    Creates a tar layer with only changed files.
    Entries are sorted and timestamps zeroed for reproducibility.
    """
    tar_path = "/tmp/layer.tar"

    # Collect changed files
    changed_files = []
    for root, dirs, files in os.walk(temp_fs):
        for f in sorted(files):  # sorted for determinism
            abs_path = os.path.join(root, f)
            rel_path = os.path.relpath(abs_path, temp_fs)

            if before_snapshot is None:
                changed_files.append((rel_path, abs_path))
            else:
                prev_mtime = before_snapshot.get(rel_path)
                curr_mtime = os.path.getmtime(abs_path)
                if prev_mtime is None or curr_mtime > prev_mtime:
                    changed_files.append((rel_path, abs_path))

    # Sort by path for determinism
    changed_files.sort(key=lambda x: x[0])

    with tarfile.open(tar_path, "w") as tar:
        for rel_path, abs_path in changed_files:
            info = tar.gettarinfo(abs_path, arcname=rel_path)
            # Zero out timestamps for reproducibility
            info.mtime = 0
            info.uid = 0
            info.gid = 0
            info.uname = ""
            info.gname = ""
            with open(abs_path, "rb") as f:
                tar.addfile(info, f)

    # Compute digest
    sha256 = hashlib.sha256()
    with open(tar_path, "rb") as f:
        while True:
            chunk = f.read(8192)
            if not chunk:
                break
            sha256.update(chunk)

    digest = sha256.hexdigest()
    os.makedirs(layers_dir, exist_ok=True)
    final_path = os.path.join(layers_dir, digest + ".tar")
    shutil.move(tar_path, final_path)

    # Return size too
    size = os.path.getsize(final_path)
    return digest
